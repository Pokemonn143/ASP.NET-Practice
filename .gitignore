## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Extras for Visual Studio

# Visual Studio local settings
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.env

# VS build logs
*.log
*.tlog
*.binlog

# VS test results
*.trx

# VS profiler and coverage
*.psess
*.vsp
*.vspx
*.coverage
*.coveragexml

# ReSharper & Rider
_ReSharper*/
*.DotSettings.user

# Local history
.vshistory/
.history/
.localhistory/

# VS Code folders (keep some allowed)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# NuGet artifacts
*.nupkg
*.snupkg

# VS-generated user/project configs
*.vc.db
*.VC.VC.opendb
*.opendb
*.dbmdl
*.pfx
*.publishsettings
